// Prisma schema — see docs/ARCHITECTURE.md for the database decision record.
// Development, test, and production target PostgreSQL. The prior SQLite
// migration history is retained under prisma/migrations-sqlite/ as an archive;
// active migrations under prisma/migrations/ are PostgreSQL-native.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model Company {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  timezone String  @default("America/Chicago")
  isDemo   Boolean @default(false)

  // Service area / operations config
  serviceZipCodes           String // JSON-encoded string[] of ZIP codes served
  supportedPests            String // JSON-encoded string[] of pest types handled
  businessHours             String // JSON-encoded weekly business-hours config
  inspectionDurationMinutes Int    @default(60)
  maxDailyInspections       Int    @default(8)
  pestCategoryConfig        String? // JSON-encoded PestCategory[] with internal potential-value ranges
  serviceArrangements       String? // JSON-encoded allowed service-arrangement identifiers

  // Lead scoring config (company-configurable, not hardcoded)
  scoringRules String // JSON-encoded scoring rule set
  mqlThreshold Int    @default(40)
  sqlThreshold Int    @default(70)

  // Marketing economics assumptions (company-entered, used for ROI comparisons)
  averageContractValueCents  Int? // nullable: unknown until entered
  estimatedCommissionPercent Float?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  users                         User[]
  inspectors                    Inspector[]
  leads                         Lead[]
  appointments                  Appointment[]
  funnelEvents                  FunnelEvent[]
  marketingSpend                MarketingSpend[]
  auditLogs                     AuditLog[]
  suppressionEntries            SuppressionEntry[]
  communications                Communication[]
  communicationProviderAccounts CommunicationProviderAccount[]
  communicationWebhookEvents    CommunicationWebhookEvent[]
  visitorAttributions           VisitorAttribution[]
}

// ---------------------------------------------------------------------------
// Auth / staff
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id])
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("owner") // "owner" | "staff"
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  auditLogs AuditLog[]
}

// ---------------------------------------------------------------------------
// Inspectors
// ---------------------------------------------------------------------------

model Inspector {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  email     String
  phone     String?
  active    Boolean @default(true)

  appointments Appointment[]
}

// ---------------------------------------------------------------------------
// Lead / CRM
// ---------------------------------------------------------------------------

model Lead {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  isDemo    Boolean @default(false)

  // Contact
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  normalizedEmail String?
  normalizedPhone String?

  // Property
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  zipCode      String?
  isHomeowner  Boolean?

  // Pest concern / qualification answers (JSON-encoded, schema-flexible by design)
  qualificationAnswers String? // JSON-encoded Record<questionId, answer>
  pestConcern          String?
  pestCategory         String? // acquisition category derived from the validated pest concern

  // Existing provider / switcher path
  hasExistingProvider  Boolean?
  existingProviderName String?
  switchReason         String? // e.g. "recurring_infestation" | "poor_service" | ...

  // Scoring / classification
  score          Int    @default(0)
  classification String @default("prospect") // "prospect" | "mql" | "sql"

  // Pipeline
  status String @default("new")
  // "new" | "engaged" | "mql" | "sql" | "inspection_booked" |
  // "inspection_completed" | "customer_won" | "customer_lost"

  outcome            String? // "won" | "lost" (set once inspection completed)
  lostReason         String?
  contractValueCents Int?
  actualPestCategory String? // staff-confirmed after inspection; distinct from acquisition category
  serviceArrangement String? // ONE_TIME | QUARTERLY | BIMONTHLY

  // Attribution (first-touch, captured at first FunnelEvent)
  source          String?
  medium          String?
  campaign        String?
  content         String?
  term            String?
  landingPage     String?
  clickId         String?
  gclid           String?
  fbclid          String?
  referrer        String?
  lastSource      String?
  lastMedium      String?
  lastCampaign    String?
  lastContent     String?
  lastTerm        String?
  lastLandingPage String?
  lastGclid       String?
  lastFbclid      String?
  lastReferrer    String?
  firstTouchAt    DateTime? @db.Timestamptz(3)
  lastTouchAt     DateTime? @db.Timestamptz(3)
  visitorId       String? // anonymous id set pre-identification, links to FunnelEvents

  // Communications consent (TCPA/CAN-SPAM boundaries)
  smsConsent                  Boolean   @default(false)
  smsConsentAt                DateTime? @db.Timestamptz(3)
  smsConsentSource            String?
  smsMarketingConsent         Boolean   @default(false)
  smsMarketingConsentAt       DateTime? @db.Timestamptz(3)
  smsMarketingConsentSource   String?
  smsOptedOutAt               DateTime? @db.Timestamptz(3)
  emailConsent                Boolean   @default(false)
  emailConsentAt              DateTime? @db.Timestamptz(3)
  emailConsentSource          String?
  emailMarketingConsent       Boolean   @default(false)
  emailMarketingConsentAt     DateTime? @db.Timestamptz(3)
  emailMarketingConsentSource String?
  emailOptedOutAt             DateTime? @db.Timestamptz(3)
  optedOutAt                  DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointments   Appointment[]
  funnelEvents   FunnelEvent[]
  notes          LeadNote[]
  communications Communication[]

  @@index([companyId, status])
  @@index([companyId, pestCategory])
  @@index([visitorId])
  @@index([companyId, normalizedEmail])
  @@index([companyId, normalizedPhone])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId  String?
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Funnel / attribution event log (append-only source of truth for analytics)
// ---------------------------------------------------------------------------

model FunnelEvent {
  id            String       @id @default(cuid())
  companyId     String
  company       Company      @relation(fields: [companyId], references: [id])
  leadId        String?
  lead          Lead?        @relation(fields: [leadId], references: [id])
  visitorId     String
  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  eventKey      String       @default(cuid())
  funnelStep    String?
  isDemo        Boolean      @default(false)

  eventType String
  // Canonical values live in src/lib/pipeline.ts. Public browsers may write
  // only non-authoritative interaction events; conversions are server-only.

  // Attribution captured at the event (first touch persisted on Lead;
  // every event keeps its own for full-path analysis later)
  source      String?
  medium      String?
  campaign    String?
  content     String?
  term        String?
  landingPage String?
  clickId     String?
  gclid       String?
  fbclid      String?
  referrer    String?

  metadata  String? // JSON-encoded event-specific payload
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([companyId, eventKey])
  @@index([companyId, eventType])
  @@index([companyId, createdAt])
  @@index([appointmentId])
  @@index([visitorId])
}

model VisitorAttribution {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visitorId String
  isDemo    Boolean @default(false)

  firstSource      String?
  firstMedium      String?
  firstCampaign    String?
  firstContent     String?
  firstTerm        String?
  firstLandingPage String?
  firstGclid       String?
  firstFbclid      String?
  firstReferrer    String?
  firstTouchedAt   DateTime @db.Timestamptz(3)

  lastSource      String?
  lastMedium      String?
  lastCampaign    String?
  lastContent     String?
  lastTerm        String?
  lastLandingPage String?
  lastGclid       String?
  lastFbclid      String?
  lastReferrer    String?
  lastTouchedAt   DateTime @db.Timestamptz(3)

  @@unique([companyId, visitorId])
  @@index([companyId, lastTouchedAt])
}

// ---------------------------------------------------------------------------
// Scheduling
// ---------------------------------------------------------------------------

model Appointment {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  leadId      String
  lead        Lead       @relation(fields: [leadId], references: [id])
  isDemo      Boolean    @default(false)
  inspectorId String?
  inspector   Inspector? @relation(fields: [inspectorId], references: [id])

  scheduledStart DateTime @db.Timestamptz(3)
  scheduledEnd   DateTime @db.Timestamptz(3)

  status String @default("booked")
  // "booked" | "rescheduled" | "cancelled" | "no_show" | "completed"

  completedAt       DateTime? @db.Timestamptz(3)
  cancelledAt       DateTime? @db.Timestamptz(3)
  rescheduledFromId String? // points at the prior Appointment.id when rescheduled

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  communications Communication[]
  funnelEvents   FunnelEvent[]

  // The double-booking guard is a PARTIAL unique index on
  // (companyId, scheduledStart) WHERE status IN ('booked', 'rescheduled'),
  // added by raw SQL in migration 20260820220719_atomic_booking_slot_guard.
  // It is not declarable as `@@unique` here — Prisma's schema DSL has no
  // filtered/partial-index construct — but it is real, DB-enforced, and
  // atomic on PostgreSQL. The previous
  // `@@unique([inspectorId, scheduledStart])` provided no real protection:
  // every booking today has `inspectorId = null` (no per-inspector
  // calendars exist yet — see docs/ARCHITECTURE.md), and SQL unique
  // indexes treat NULLs as distinct, so multiple null-inspector rows at
  // the identical scheduledStart never violated it. Scoping by
  // (companyId, scheduledStart) instead matches the app's actual
  // single-shared-calendar model (see src/lib/scheduling.ts —
  // `assertSlotBookable`'s overlap check is already company-wide, not
  // per-inspector). Filtering to active statuses is required so a
  // cancelled appointment doesn't permanently block re-booking that slot.
  // See docs/ARCHITECTURE.md Scheduling architecture for full detail.
  @@index([companyId, scheduledStart])
  @@index([inspectorId, scheduledStart])
}

// ---------------------------------------------------------------------------
// Marketing economics
// ---------------------------------------------------------------------------

model MarketingSpend {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  source      String
  medium      String?
  campaign    String?
  content     String?
  periodStart DateTime @db.Timestamptz(3)
  periodEnd   DateTime @db.Timestamptz(3)
  amountCents Int
  isDemo      Boolean  @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([companyId, source, periodStart])
}

// ---------------------------------------------------------------------------
// Suppression (durable, cross-lead/cross-session opt-out protection)
// ---------------------------------------------------------------------------

model SuppressionEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  channel String // "email" | "sms" | "all" ("all" = blanket opt-out, matches
  // the existing undifferentiated Lead.optedOutAt semantics — see canSend)
  scope   String @default("all") // "marketing" | "all"

  identifierType  String // "email" | "phone"
  identifierValue String // normalized (see src/lib/suppression.ts)

  reason String // e.g. "opted_out"
  source String // e.g. "crm_manual_optout" — where the suppression originated

  metadata  String? // JSON-encoded extra context
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([companyId, channel, identifierType, identifierValue])
  @@index([companyId, identifierType, identifierValue])
}

// ---------------------------------------------------------------------------
// Communication delivery log (operational record of every send attempt)
// ---------------------------------------------------------------------------

model Communication {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id])

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  providerAccountId String?
  providerAccount   CommunicationProviderAccount? @relation(fields: [providerAccountId], references: [id])

  channel   String // "email" | "sms"
  type      String // see src/lib/pipeline.ts COMMUNICATION_TYPES
  direction String @default("outbound") // "outbound" | "inbound"
  purpose   String @default("transactional") // "transactional" | "marketing"
  provider  String @default("development")
  dedupeKey String

  status String // see src/lib/pipeline.ts COMMUNICATION_STATUSES
  // "blocked" | "queued" | "sent" | "failed" | "delivered" | "bounced" |
  // "undeliverable" — only blocked/queued/sent/failed are ever written
  // today; the delivery-confirmed statuses are declared for a future
  // provider-webhook integration and must never be written without one.

  blockedReason String? // set when status = "blocked" — why sendIfAllowed refused (suppressed / no consent / opted out)
  failureReason String? // set when status = "failed" — provider-reported error/rejection

  to                String // destination address/number targeted for this attempt
  from              String?
  subject           String? // email only
  body              String? // inbound reply content only; outbound bodies are not persisted
  providerMessageId String? // set once a live provider accepts the send; correlates future delivery-status webhooks. Unset while only the dev provider is wired up.

  attemptedAt      DateTime  @default(now()) @db.Timestamptz(3)
  acceptedAt       DateTime? @db.Timestamptz(3)
  deliveredAt      DateTime? @db.Timestamptz(3)
  failedAt         DateTime? @db.Timestamptz(3)
  bouncedAt        DateTime? @db.Timestamptz(3)
  receivedAt       DateTime? @db.Timestamptz(3)
  providerStatusAt DateTime? @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @db.Timestamptz(3)

  webhookEvents CommunicationWebhookEvent[]

  @@unique([companyId, dedupeKey])
  @@unique([companyId, provider, providerMessageId])
  @@index([companyId, leadId])
  @@index([companyId, status])
  @@index([appointmentId])
}

model CommunicationProviderAccount {
  id                String   @id @default(cuid())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  provider          String
  externalAccountId String
  channel           String
  address           String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  communications Communication[]
  webhookEvents  CommunicationWebhookEvent[]

  @@unique([provider, externalAccountId])
  @@index([companyId, channel])
}

model CommunicationWebhookEvent {
  id                String                       @id @default(cuid())
  companyId         String
  company           Company                      @relation(fields: [companyId], references: [id])
  providerAccountId String
  providerAccount   CommunicationProviderAccount @relation(fields: [providerAccountId], references: [id])
  communicationId   String?
  communication     Communication?               @relation(fields: [communicationId], references: [id])
  provider          String
  providerEventId   String
  eventType         String
  payloadHash       String
  outcome           String
  occurredAt        DateTime                     @db.Timestamptz(3)
  receivedAt        DateTime                     @default(now()) @db.Timestamptz(3)
  processedAt       DateTime?                    @db.Timestamptz(3)

  @@unique([provider, providerEventId])
  @@index([companyId, receivedAt])
  @@index([communicationId])
}

// ---------------------------------------------------------------------------
// Audit log
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   String? // JSON-encoded before/after or context
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([companyId, entityType, entityId])
}
