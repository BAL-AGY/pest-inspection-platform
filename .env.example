# Copy to .env and fill in real values for local/dev use.
# Never commit .env with real secrets — .env* is gitignored except .env.example.

# Deployment identity. Render runs staging with NODE_ENV=production and the
# explicit staging boundary below. Omit DEPLOYMENT_ENV locally; production may
# set it to "production" or omit it (production is the fail-safe default).
# DEPLOYMENT_ENV="staging"
# AUTH_URL="https://STAGING_HOST"

# PostgreSQL datasource for development, test, and production. Use a dedicated
# database per environment and obtain production credentials from the host's
# secret manager. This example is intentionally nonfunctional.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# REQUIRED IN PRODUCTION. Shared atomic backing store for rate limiting across
# every application instance. Prefer TLS (rediss://) and provider-managed
# authentication in production. Local development may use redis://localhost:6379.
REDIS_URL="rediss://USER:PASSWORD@HOST:6379"

# REQUIRED IN DEPLOYED ENVIRONMENTS. Production requires "disabled" until a
# live adapter exists. Explicit staging requires "deterministic": a no-network
# adapter that persists simulated acceptance for demos without sending.
COMMUNICATION_PROVIDER="disabled"
COMMUNICATION_JOB_SECRET="generate-an-independent-scheduler-secret"
# Required only with DEPLOYMENT_ENV=staging + deterministic communications.
# COMMUNICATION_TEST_WEBHOOK_SECRET="generate-an-independent-staging-only-secret"

# REQUIRED IN PRODUCTION. Auth.js (NextAuth) session secret.
# Generate independently with: openssl rand -base64 32
AUTH_SECRET="generate-an-independent-random-value"

# REQUIRED IN PRODUCTION — no exceptions. Signs the public funnel's
# lead-ownership capability tokens (src/lib/funnel-capability.ts). In
# production (NODE_ENV=production) there is NO fallback: the app fails
# closed both at startup (src/instrumentation.ts) and on every request if
# this is unset, rather than silently reusing AUTH_SECRET. Falling back to
# AUTH_SECRET is dev/test-only convenience — never rely on it in
# production, since it couples two unrelated trust domains (staff session
# signing vs. anonymous funnel ownership) and risks a well-known
# development placeholder value being deployed unchanged.
# Generate independently with: openssl rand -base64 32
FUNNEL_CAPABILITY_SECRET="generate-a-different-independent-random-value"

# REQUIRED IN PRODUCTION. Keeps privacy-hashed rate-limit identifiers stable.
# Generate independently with: openssl rand -base64 32
RATE_LIMIT_IDENTIFIER_SECRET="generate-a-third-independent-random-value"

# Local/test seeding defaults to owner@example.com / a documented development
# password. Production seeding has no defaults: both values are mandatory,
# must be explicit, and the password must meet production-strength validation.
# The seed never prints the password and never overwrites an existing user's hash.
# SEED_OWNER_EMAIL="owner@your-company.example"
# SEED_OWNER_PASSWORD="generate-a-separate-random-initial-password"
# Staging seed/reseed guard; never configure this in production.
# STAGING_DEMO_CONFIRM="demo-pest-control"

# Trust X-Forwarded-For only after verifying the selected host's proxy chain.
# RATE_LIMIT_TRUSTED_PROXY_HOPS=1

# Email/SMS providers are abstracted (see src/lib/communications). No live
# provider is wired up yet. When one is added, its credentials go here, e.g.:
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
