# Copy to .env and fill in real values for local/dev use.
# Never commit .env with real secrets — .env* is gitignored except .env.example.

# Prisma datasource. Dev/test in this repo uses SQLite (see docs/ARCHITECTURE.md).
# Production target is PostgreSQL — swap this to a postgresql:// URL and cut
# over the Prisma schema `provider` before deploying.
DATABASE_URL="file:./prisma/dev.db"

# Auth.js (NextAuth) session secret. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-real-secret"

# REQUIRED IN PRODUCTION — no exceptions. Signs the public funnel's
# lead-ownership capability tokens (src/lib/funnel-capability.ts). In
# production (NODE_ENV=production) there is NO fallback: the app fails
# closed both at startup (src/instrumentation.ts) and on every request if
# this is unset, rather than silently reusing AUTH_SECRET. Falling back to
# AUTH_SECRET is dev/test-only convenience — never rely on it in
# production, since it couples two unrelated trust domains (staff session
# signing vs. anonymous funnel ownership) and risks a well-known
# development placeholder value being deployed unchanged.
# Generate with: openssl rand -base64 32
FUNNEL_CAPABILITY_SECRET="replace-with-a-real-secret"

# Email/SMS providers are abstracted (see src/lib/communications). No live
# provider is wired up yet. When one is added, its credentials go here, e.g.:
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
